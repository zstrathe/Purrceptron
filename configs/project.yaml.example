cats:                       # the individuals to tell apart (any animal; the key keeps its name)
- Cat1
- Cat2
- Cat3
subject:                    # optional: the dashboard's wording for the animals
  animal: cat               # default: the first of deployment.tracking_objects
  plural: cats              # default: animal + "s"
camera:
  device: /dev/video0
  width: 1920
  height: 1080
  fps: 30
  format: MJPG
collection:
  output_dir: data/raw
  images_per_session: 200
  capture_interval_ms: 500
  auto_capture_interval_sec: 3      # seconds between images while a visit is named
  min_images_per_cat: 300
  jpeg_quality: 95
web_ui:
  host: 0.0.0.0
  port: 5003
  local_name: cats          # with the boot service: http://cats.local (blank: hostname only)
  preview_width: 960
  preview_height: 540
deployment:
  hailo_apps_dir: ./hailo-apps
  hef_path: ""
  labels_json: ""
  detection_threshold: 0.5
  hw_arch: hailo10h
  track_all: true
  filter_classes: []
  preview_fps: 15
feeding:
  enabled: false
  db_path: data/feeding_log.db
  cooldown_seconds: 30
  min_detection_frames: 3
  log_interval_seconds: 60
detection_capture:
  enabled: false
  output_dir: data/raw
  filter_labels: []
  unlabeled_classes:
  - cat
  min_interval_seconds: 15
  max_captures_per_session: 0
  save_labeled_only: false
  jpeg_quality: 95
  csv_logging: true
label_review:
  host: 0.0.0.0
  port: 5001
  trash_dir: data/trash
classifier:
  enabled: false
  model_path: models/cat_classifier.pte
  bowl_roi:
  - 760
  - 390
  - 1160
  - 790
  stability_frames: 5
  classify_interval_seconds: 1.0
  confidence_threshold: 0.5
  vote_window_size: 10
  db_path: data/classifier_log.db
  crop_padding: 0.0
  roi_overlap_threshold: 0.01
  cpu_core: 3
classifier_training:
  phase1_epochs: 20
  phase2_epochs: 40
  phase3_epochs: 20
  phase1_lr: 0.001
  phase2_backbone_lr: 1.0e-05
  phase2_head_lr: 0.0001
  weight_decay: 0.005
  batch_size: 32
  label_smoothing: 0.1
  gradient_clip_norm: 1.0
  warmup_epochs: 5
  patience: 15
  optimizer: AdamW
  session_gap_minutes: 5
  mixup_alpha: 0.2
  balance_method: oversample     # oversample | loss_weights | off
  cv_folds: 5
  augmentation:
    horizontal_flip: true
    brightness_contrast: true
    brightness_limit: 0.3
    contrast_limit: 0.3
    shift_scale_rotate: true
    rotate_limit: 10
    gaussian_blur: true
    gaussian_noise: true
    coarse_dropout: true
    hue_saturation: true
    clahe: true
# Training from the Pi dashboard (Training tab). The tab saves changes to
# configs/runtime.yaml and tokens to configs/secrets.yaml (both gitignored).
training_backend:
  backend: local_pc          # local_pc | hf_jobs
  min_images_per_cat: 30     # labeled images with bounding boxes needed per cat
  local_pc:                  # train_worker.py on your PC (needs WORKER_TOKEN in its .env)
    host: ''
    port: 5004
  hf_jobs:                   # Hugging Face Jobs (prepaid credits)
    namespace: ''
    flavor: l4x1              # about 12 min and $0.16 per full training
    timeout: 2h
    image: ''                # blank: pytorch/pytorch image matching the Pi's torch
    bucket: ''               # blank: <namespace>/cat-training
# Nightly backups (Backup tab). The tab saves changes to configs/runtime.yaml.
backup:
  destination: "off"         # off | local_pc | hf
  time: "03:00"              # local time
  keep_days: 30              # snapshots older than this are deleted (newest always kept)
  local_pc:                  # blank: the Training tab's local_pc address
    host: ''
    port: ''
  hf:                        # blank: the token's user, bucket <namespace>/cat-backups
    namespace: ''
    bucket: ''
logging:
  keep_days: 90              # detection logs (logs/detection/) older than this are deleted; 0 keeps all
