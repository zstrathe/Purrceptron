# Git / IDE / caches
.git/
.claude/
.pytest_cache/
__pycache__/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python envs
.venv*/
venv*/
venv_train/

# Environment secrets
.env

# Large data (already gitignored but be explicit)
data/
models/
runs/
versions/

# Training machine only. train/ IS synced: the Pi's Training tab crops,
# splits, and bundles train/ into each remote job.
train_worker.py
requirements-training.txt

# Large model weights (Pi uses .hef files)
*.pt
*.pte

# Hailo SDK (installed on Pi via setup_pi.sh, not synced)
hailo-apps/

# Dev-only scripts
scripts/setup_training.sh
scripts/windows_port_forward.ps1
scripts/worker.sh
scripts/transfer_model.sh
scripts/sync_to_pi.sh
scripts/restore_pi.sh
scripts/install_pi.sh
scripts/update_pi.sh
scripts/_pi_remote.sh
scripts/pull_dataset.sh
scripts/push_labels_to_pi.py

# Pi-only runtime state (written by dashboard, not synced)
configs/runtime.yaml
configs/secrets.yaml
# The Pi's logs: listed here so the --delete in sync_to_pi.sh can't remove
# them (the PC has no copy of pi_dashboard.out or its rotated files).
/logs/

# Log files
*.log

# Dev-only requirements
requirements-scripts.txt

# Docs
docs/
README.md
